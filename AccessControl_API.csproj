    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AccessControl.DTO\**" />
    <Compile Remove="AccessControl_Web\**" />
    <Content Remove="AccessControl.DTO\**" />
    <Content Remove="AccessControl_Web\**" />
