@model IEnumerable<AccessControl_API.Models.DTO.GroupDTO>

@{
    ViewData["Title"] = "Groups";
    var hasGroups = Model != null && Model.Any();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-diagram-3"></i> Group Management</h2>
        <div>
            @if (hasGroups)
            {
                <a asp-action="Statistics" class="btn btn-info me-2">
                    <i class="bi bi-bar-chart"></i> View Statistics
                </a>
            }
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Group
            </a>
            @if (!hasGroups)
            {
                <form asp-action="CreateDefaults" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success" onclick="return confirm('Create default groups (Admin, Security, Employee, Visitor)?')">
                        <i class="bi bi-lightning-fill"></i> Create Default Groups
                    </button>
                </form>
            }
        </div>
    </div>

    @if (!hasGroups)
    {
        <div class="alert alert-info">
            <h5><i class="bi bi-info-circle"></i> No groups found</h5>
            <p>Get started by creating default groups or create a custom group.</p>
            <div class="d-flex gap-2">
                <form asp-action="CreateDefaults" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success" onclick="return confirm('This will create 4 default groups: Admin, Security, Employee, and Visitor. Continue?')">
                        <i class="bi bi-lightning-fill"></i> Create Default Groups (Quick Start)
                    </button>
                </form>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create Custom Group
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var group in Model)
            {
                <div class="col-md-4 col-lg-3 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <i class="bi bi-people-fill text-primary" style="font-size: 3rem;"></i>
                            </div>
                            <h5 class="card-title">@group.Name</h5>
                            <p class="text-muted mb-0">ID: @group.Id</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-3">
            <p class="text-muted">Total Groups: <strong>@Model.Count()</strong></p>
        </div>
    }
</div>
