@model AccessControl_API.Models.DTO.RegistrationRequestDTO

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var groups = ViewBag.Groups as IEnumerable<AccessControl_API.Models.DTO.GroupDTO> ?? new List<AccessControl_API.Models.DTO.GroupDTO>();
    var hasGroups = groups.Any();
}

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100 py-5">
        <div class="col-md-8 col-lg-6">
            @if (!hasGroups)
            {
                <div class="alert alert-warning shadow-sm mb-4" role="alert">
                    <h5 class="alert-heading">
                        <i class="bi bi-exclamation-triangle-fill"></i> No Groups Available
                    </h5>
                    <p>Groups must be created before registration. Please contact an administrator.</p>
                    <hr>
                    <p class="mb-0">
                        <strong>Admin?</strong> 
                        <a asp-controller="Groups" asp-action="Index" class="alert-link">Manage Groups</a>
                    </p>
                </div>
            }

            <div class="card shadow-lg border-0 rounded-lg">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0">
                        <i class="bi bi-person-plus-fill"></i> Create Account
                    </h3>
                    <p class="mb-0 small">Join the Access Control System</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Register" method="post" id="registerForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">
                                    <i class="bi bi-person"></i> First Name
                                </label>
                                <input asp-for="FirstName" 
                                       class="form-control" 
                                       placeholder="Enter first name"
                                       autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">
                                    <i class="bi bi-person"></i> Last Name
                                </label>
                                <input asp-for="LastName" 
                                       class="form-control" 
                                       placeholder="Enter last name"
                                       autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                <i class="bi bi-envelope"></i> Email Address
                            </label>
                            <input asp-for="Email" 
                                   class="form-control" 
                                   placeholder="Enter email address"
                                   autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdentificationNumber" class="form-label">
                                <i class="bi bi-card-text"></i> Identification Number
                            </label>
                            <input asp-for="IdentificationNumber" 
                                   class="form-control" 
                                   placeholder="Enter ID or passport number" />
                            <span asp-validation-for="IdentificationNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                <i class="bi bi-lock"></i> Password
                            </label>
                            <input asp-for="Password" 
                                   type="password" 
                                   class="form-control" 
                                   placeholder="Enter password (min 6 characters)"
                                   autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text">
                                <i class="bi bi-info-circle"></i> Must be at least 6 characters long
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="GroupId" class="form-label">
                                <i class="bi bi-diagram-3"></i> Select Group
                            </label>
                            @if (hasGroups)
                            {
                                <select asp-for="GroupId" class="form-select">
                                    <option value="">-- Select your role --</option>
                                    @foreach (var group in groups)
                                    {
                                        <option value="@group.Id">@group.Name</option>
                                    }
                                </select>
                                <div class="form-text">
                                    <i class="bi bi-question-circle"></i> Choose the group that matches your role
                                </div>
                            }
                            else
                            {
                                <select asp-for="GroupId" class="form-select" disabled>
                                    <option value="">-- No groups available --</option>
                                </select>
                                <div class="form-text text-danger">
                                    <i class="bi bi-exclamation-circle"></i> Groups must be created first
                                </div>
                            }
                            <span asp-validation-for="GroupId" class="text-danger small"></span>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="d-grid gap-2">
                            @if (hasGroups)
                            {
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-person-plus"></i> Create Account
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-lg" disabled>
                                    <i class="bi bi-person-plus"></i> Registration Disabled
                                </button>
                            }
                            <a asp-action="Login" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            @if (!hasGroups)
            {
                <div class="card mt-3 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-lightbulb"></i> Recommended Default Groups
                        </h6>
                        <ul class="mb-3">
                            <li><strong>Admin</strong> - Full system access</li>
                            <li><strong>Security</strong> - Security personnel</li>
                            <li><strong>Employee</strong> - Regular employees</li>
                            <li><strong>Visitor</strong> - Temporary guests</li>
                        </ul>
                        <a asp-controller="Groups" asp-action="Index" class="btn btn-success btn-sm">
                            <i class="bi bi-arrow-right-circle"></i> Manage Groups
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
