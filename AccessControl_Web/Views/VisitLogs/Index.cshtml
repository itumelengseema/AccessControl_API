@model IEnumerable<AccessControl_API.Models.DTO.VisitLogResponseDTO>

@{
    ViewData["Title"] = "Active Visitors";
    var activeCount = Model?.Count() ?? 0;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-people-fill"></i> Active Visitors</h2>
            <p class="text-muted mb-0">
                <span class="badge bg-success">@activeCount Active</span> visitor(s) currently in the building
            </p>
        </div>
        <a asp-action="CheckIn" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i> Check In Visitor
        </a>
    </div>

    @if (activeCount == 0)
    {
        <div class="alert alert-info">
            <h5><i class="bi bi-info-circle"></i> No active visitors</h5>
            <p class="mb-0">There are currently no visitors checked in. Click "Check In Visitor" to register a new visitor.</p>
        </div>
    }
    else
    {
        <!-- Search and Filter -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <input type="text" 
                               id="searchInput" 
                               class="form-control" 
                               placeholder="?? Search by name, ID, or car registration..." 
                               onkeyup="filterVisitors()">
                    </div>
                    <div class="col-md-3">
                        <select id="sortBy" class="form-select" onchange="sortVisitors()">
                            <option value="newest">Newest First</option>
                            <option value="oldest">Oldest First</option>
                            <option value="name">Name (A-Z)</option>
                            <option value="duration">Longest Duration</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                            <i class="bi bi-x-circle"></i> Clear
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Visitors Table -->
        <div class="card shadow">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="visitorsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Visitor</th>
                                <th>ID Number</th>
                                <th>Car Registration</th>
                                <th>Check-In Time</th>
                                <th>Duration</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var visitor in Model)
                            {
                                var duration = DateTime.Now - visitor.CheckInTime;
                                var durationText = duration.TotalHours >= 1
                                    ? $"{(int)duration.TotalHours}h {duration.Minutes}m"
                                    : $"{duration.Minutes}m";

                                <tr class="visitor-row" 
                                    data-name="@visitor.UserFirstName @visitor.UserLastName" 
                                    data-id="@visitor.UserIdentificationNumber"
                                    data-car="@(visitor.CarRegistrationNumber ?? "")"
                                    data-checkin="@visitor.CheckInTime.Ticks">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle me-2">
                                                @visitor.UserFirstName.Substring(0, 1)@visitor.UserLastName.Substring(0, 1)
                                            </div>
                                            <div>
                                                <strong>@visitor.UserFirstName @visitor.UserLastName</strong>
                                                @if (!string.IsNullOrEmpty(visitor.UserEmail) && !visitor.UserEmail.Contains("@temp.local"))
                                                {
                                                    <br />
                                                    <small class="text-muted">@visitor.UserEmail</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td><code>@visitor.UserIdentificationNumber</code></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(visitor.CarRegistrationNumber))
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-car-front"></i> @visitor.CarRegistrationNumber
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <small>@visitor.CheckInTime.ToString("dd MMM yyyy")</small><br />
                                        <strong>@visitor.CheckInTime.ToString("HH:mm")</strong>
                                    </td>
                                    <td>
                                        <span class="badge @(duration.TotalHours >= 4 ? "bg-warning" : "bg-info")">
                                            <i class="bi bi-clock"></i> @durationText
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="CheckOut" asp-route-id="@visitor.Id" method="post" class="d-inline">
                                            <button type="submit" 
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Check out @visitor.UserFirstName @visitor.UserLastName?')">
                                                <i class="bi bi-box-arrow-right"></i> Check Out
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <p class="text-muted">
                Total: <strong id="visibleCount">@activeCount</strong> visitor(s) | 
                <span id="filteredMessage"></span>
            </p>
        </div>
    }
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 14px;
    }
</style>

@section Scripts {
    <script>
        function filterVisitors() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('.visitor-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.getAttribute('data-name').toLowerCase();
                const id = row.getAttribute('data-id').toLowerCase();
                const car = row.getAttribute('data-car').toLowerCase();
                const notes = row.textContent.toLowerCase();

                if (name.includes(searchTerm) || id.includes(searchTerm) || 
                    car.includes(searchTerm) || notes.includes(searchTerm)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('visibleCount').textContent = visibleCount;
            document.getElementById('filteredMessage').textContent = 
                searchTerm ? `Filtered from @activeCount total` : '';
        }

        function sortVisitors() {
            const sortBy = document.getElementById('sortBy').value;
            const tbody = document.querySelector('#visitorsTable tbody');
            const rows = Array.from(document.querySelectorAll('.visitor-row'));

            rows.sort((a, b) => {
                switch(sortBy) {
                    case 'newest':
                        return parseInt(b.getAttribute('data-checkin')) - parseInt(a.getAttribute('data-checkin'));
                    case 'oldest':
                        return parseInt(a.getAttribute('data-checkin')) - parseInt(b.getAttribute('data-checkin'));
                    case 'name':
                        return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
                    case 'duration':
                        return parseInt(a.getAttribute('data-checkin')) - parseInt(b.getAttribute('data-checkin'));
                    default:
                        return 0;
                }
            });

            rows.forEach(row => tbody.appendChild(row));
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('sortBy').value = 'newest';
            filterVisitors();
            sortVisitors();
        }

        // Auto-refresh every 30 seconds to update durations
        setInterval(() => {
            location.reload();
        }, 30000);
    </script>
}
